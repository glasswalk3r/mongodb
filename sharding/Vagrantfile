# -*- mode: ruby -*-
# vi: set ft=ruby :

# Sharded cluster with two shards. Every replica set has a single member:
#   config  config server "cfgrs" (27019) and mongos (27017)
#   shard1  shard "shard1rs" (27018)
#   shard2  shard "shard2rs" (27018)
NODES = {
  "config" => "192.168.56.21",
  "shard1" => "192.168.56.22",
  "shard2" => "192.168.56.23",
}

Vagrant.configure("2") do |config|
  config.vm.box = "RockyLinux"
  # Ansible runs from the host; nothing needs the shared folder.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.linked_clone = true
    vb.memory = 1024
    vb.cpus = 1
  end

  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip

      # Provision once, from the last VM, so the play covers the whole cluster
      # and mongos can register both shards.
      if name == NODES.keys.last
        node.vm.provision "ansible" do |ansible|
          ansible.playbook = "playbook.yml"
          ansible.config_file = "ansible.cfg"
          ansible.compatibility_mode = "2.0"
          ansible.limit = "all"
          # Replica set groups are named after the set (see group_vars).
          ansible.groups = {
            "cfgrs" => ["config"],
            "shard1rs" => ["shard1"],
            "shard2rs" => ["shard2"],
            "shards:children" => ["shard1rs", "shard2rs"],
            "mongos" => ["config"],
          }
          ansible.host_vars = NODES.to_h { |n, i| [n, { "node_ip" => i }] }
        end
      end
    end
  end
end
