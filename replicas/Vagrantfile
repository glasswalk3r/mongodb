# -*- mode: ruby -*-
# vi: set ft=ruby :

require "yaml"

# Environment settings live in config.yml.
CONFIG = YAML.safe_load_file(File.join(__dir__, "config.yml"))
NODES = CONFIG.fetch("nodes")
DEFAULT_PORT = CONFIG.fetch("port")
DOMAIN = CONFIG.fetch("domain")
REPLICA_SET = CONFIG.fetch("replica_set")

Vagrant.configure("2") do |config|
  config.vm.box = "RockyLinux"
  # Ansible runs from the host; nothing needs the shared folder.
  # config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.linked_clone = true
    vb.memory = 1024
    vb.cpus = 1
  end

  # This makes sure the vm restart fast by avoiding a double mounting by systemd and Vagrant.
  # The tradeoff is that the volume won't be mounted if the vm reboot is not managed by the vagrant CLI.
  config.vm.allow_fstab_modification = false

  config.vbguest.auto_update = false

  config.hostmanager.enabled = true
  config.hostmanager.manage_guest = true
  config.hostmanager.ignore_private_ip = false
  config.hostmanager.include_offline = true

  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.hostmanager.aliases = ["#{name}.#{DOMAIN}"]
      node.vm.network "private_network", ip: ip

      node.vm.provision "ansible" do |ansible|
        ansible.playbook = "playbook.yml"
        ansible.config_file = "ansible.cfg"
        ansible.compatibility_mode = "2.0"
        ansible.groups = { "rs0" => NODES.keys }
        ansible.host_vars = NODES.to_h { |n, i| [n, { "node_ip" => i }] }
      end

      # VirtualBox boots the VMs one at a time, so provision once, from the
      # last VM: a single ansible-playbook run then configures every member in
      # parallel (one fork per host).
      if name == NODES.keys.last
        node.vm.provision "ansible" do |ansible|
          ansible.playbook = "playbook.yml"
          ansible.config_file = "ansible.cfg"
          ansible.compatibility_mode = "2.0"
          ansible.limit = "all"
          ansible.host_vars = NODES.to_h {|key, value| [key, {bind_ip: "127.0.0.1,#{value}"}]}
          ansible.extra_vars = {
            replica_set_name: REPLICA_SET,
            replica_set_members: NODES.keys.map {|hostname| "#{hostname}.#{DOMAIN}:#{DEFAULT_PORT}" },
            cache_size_gb: 0.25,
            oplog_size_mb: 990,
            ftdc_dir_size_mb: 50,
            enable_firewall: true
          }
        end
      end
    end
  end
end
