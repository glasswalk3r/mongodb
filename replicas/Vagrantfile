# -*- mode: ruby -*-
# vi: set ft=ruby :

require "fileutils"
require "yaml"

# Environment settings live in config.yaml.
CONFIG = YAML.safe_load_file(File.join(__dir__, "config.yaml"))
NODES = CONFIG.fetch("nodes")
DEFAULT_PORT = CONFIG.fetch("port")
DOMAIN = CONFIG.fetch("domain")
REPLICA_SET = CONFIG.fetch("replica_set")
DATA_DISK_MB = CONFIG.fetch("data_disk_mb")
DISKS_DIR = File.join(__dir__, ".vagrant", "disks")
# Bandwidth group of the data disk. Its limit starts high enough to never
# throttle; lower it with VBoxManage bandwidthctl (see README.md).
BANDWIDTH_GROUP = "datadisk"
UNTHROTTLED = "1000M"
# Local MongoDB package mirror made by sync-mongodb-repo.py. When present, the
# guests install from it through the /vagrant synced folder instead of
# downloading the packages from repo.mongodb.org.
LOCAL_REPO_VARS =
  if File.exist?(File.join(__dir__, "mongodb-repo", "repodata", "repomd.xml"))
    {
      repo_baseurl: "file:///vagrant/mongodb-repo/",
      repo_gpgkey: "file:///vagrant/mongodb-repo/RPM-GPG-KEY-mongodb"
    }
  else
    {}
  end

Vagrant.configure("2") do |config|
  config.vm.box = "RockyLinux"
  # The default /vagrant synced folder stays enabled: the guests install
  # MongoDB from /vagrant/mongodb-repo when it exists (LOCAL_REPO_VARS).

  config.vm.provider "virtualbox" do |vb|
    vb.linked_clone = true
    vb.memory = 1024
    vb.cpus = 1
  end

  # This makes sure the vm restart fast by avoiding a double mounting by systemd and Vagrant.
  # The tradeoff is that the volume won't be mounted if the vm reboot is not managed by the vagrant CLI.
  config.vm.allow_fstab_modification = false

  config.vbguest.auto_update = false

  config.hostmanager.enabled = true
  config.hostmanager.manage_guest = true
  config.hostmanager.ignore_private_ip = false
  config.hostmanager.include_offline = true

  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.hostmanager.aliases = ["#{name}.#{DOMAIN}"]
      node.vm.network "private_network", ip: ip

      # Data disk for dbPath: a regular VDI on SATA port 1, outside the linked
      # clone, attached to a bandwidth group so it can be throttled. The role
      # formats and mounts it (data_device below). createmedium and
      # bandwidthctl add only run when the VDI doesn't exist yet, that is, for
      # a new VM: vagrant destroy deletes the attached disk with the VM.
      data_disk = File.join(DISKS_DIR, "#{name}-data.vdi")
      node.vm.provider "virtualbox" do |vb|
        vb.name = "replicas-#{name}"
        unless File.exist?(data_disk)
          FileUtils.mkdir_p(DISKS_DIR)
          vb.customize ["createmedium", "disk", "--filename", data_disk,
                        "--size", DATA_DISK_MB, "--format", "VDI"]
          vb.customize ["bandwidthctl", :id, "add", BANDWIDTH_GROUP,
                        "--type", "disk", "--limit", UNTHROTTLED]
        end
        # --nonrotational: the host disk is an SSD (NVMe), so the guest sees
        # rotational=0. --discard: passes TRIM through, so fstrim in the guest
        # shrinks the dynamically allocated VDI after MongoDB frees space.
        vb.customize ["storageattach", :id, "--storagectl", "SATA", "--port", 1,
                      "--device", 0, "--type", "hdd", "--medium", data_disk,
                      "--nonrotational", "on", "--discard", "on",
                      "--bandwidthgroup", BANDWIDTH_GROUP]
      end

      # In case VirtualBox kept the disk registered or on disk, so the next
      # vagrant up creates a fresh one.
      node.trigger.after :destroy do |t|
        t.ruby do
          if File.exist?(data_disk)
            system("VBoxManage", "closemedium", "disk", data_disk, "--delete",
                   err: File::NULL)
            FileUtils.rm_f(data_disk)
          end
        end
      end

      # Vagrant's NetworkManager profile for the private network sets
      # gateway=192.168.56.1, adding a second default route. When it gets the
      # lower metric, internet traffic goes to the host-only network and is
      # dropped (e.g. dnf times out). Keep the default route on NAT only.
      # Vagrant rewrites the profile on every boot, hence run: "always". It
      # also moves it in from /tmp with the user_tmp_t label, which SELinux
      # won't let NetworkManager replace, so relabel it first.
      node.vm.provision "private-net-no-default-route", type: "shell", run: "always", inline: <<-SHELL
        set -eu
        restorecon -R /etc/NetworkManager/system-connections
        dev=$(ip -o -4 addr show to #{ip} | awk '{print $2}')
        con=$(nmcli -g GENERAL.CONNECTION device show "$dev")
        nmcli connection modify "$con" ipv4.never-default yes
        nmcli connection up "$con" >/dev/null
      SHELL

      # VirtualBox boots the VMs one at a time, so provision once, from the
      # last VM: a single ansible-playbook run then configures every member in
      # parallel (one fork per host).
      if name == NODES.keys.last
        node.vm.provision "ansible" do |ansible|
          ansible.playbook = "playbook.yml"
          ansible.config_file = "ansible.cfg"
          ansible.compatibility_mode = "2.0"
          ansible.limit = "all"
          ansible.host_vars = NODES.to_h {|key, value| [key, {bind_ip: "127.0.0.1,#{value}"}]}
          ansible.extra_vars = {
            replica_set_name: REPLICA_SET,
            replica_set_members: NODES.keys.map {|hostname| "#{hostname}.#{DOMAIN}:#{DEFAULT_PORT}" },
            cache_size_gb: 0.25,
            oplog_size_mb: 990,
            ftdc_dir_size_mb: 50,
            enable_firewall: true,
            data_device: "/dev/sdb"
          }.merge(LOCAL_REPO_VARS)
        end
      end
    end
  end
end
