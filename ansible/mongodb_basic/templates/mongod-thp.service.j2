# {{ ansible_managed }}
[Unit]
Description=Transparent Huge Pages settings for mongod
DefaultDependencies=no
After=sysinit.target local-fs.target tuned.service
Before=mongod.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo {{ thp_enabled }} > {{ thp_sysfs }}/enabled'
ExecStart=/bin/sh -c 'echo {{ thp_defrag }} > {{ thp_sysfs }}/defrag'
ExecStart=/bin/sh -c 'echo {{ thp_max_ptes_none }} > {{ thp_sysfs }}/khugepaged/max_ptes_none'

[Install]
WantedBy=multi-user.target
