# {{ ansible_managed }}
[Unit]
Wants=mongod-thp.service chronyd.service
After=mongod-thp.service chronyd.service

[Service]
LimitNOFILE={{ limit_nofile }}
LimitNPROC={{ limit_nproc }}
LimitFSIZE=infinity
LimitCPU=infinity
LimitAS=infinity
LimitMEMLOCK=infinity
TasksMax=infinity
TasksAccounting=false
{% if glibc_rseq_disable %}
Environment=GLIBC_TUNABLES=glibc.pthread.rseq=0
{% endif %}
